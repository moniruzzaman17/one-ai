NODE_ENV=development
APP_URL=http://localhost:3000
APP_VERSION=0.1.14

# cPanel can set ONEAI_ENV_FILE=/home/greenmin/oneai-config/.env in its UI
# instead of duplicating every value in the public application root.

# Neon pooled connection for the app and direct connection for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/one_ai?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/one_ai?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Used only when the admins table is empty. Rotate after first login.
INITIAL_ADMIN_NAME=OneAI Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# Local defaults. Production paths live outside the public web root.
UPLOAD_DIR=.data/uploads
RECORDING_DIR=.data/recordings
MAX_UPLOAD_BYTES=20971520
RECORDING_RETENTION_DAYS=90

# Optional runtime overrides.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
WIDGET_SESSION_TTL_SECONDS=300
MAX_CALL_SECONDS=1800
CALL_IDLE_SECONDS=180
