{
  "name": "one-ai",
  "version": "0.1.15",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "deploy:prepare": "tsx scripts/prepare-standalone.ts",
    "cpanel:build": "node scripts/cpanel-build.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "bufferutil": "^4.1.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.43.0",
    "mammoth": "^1.12.2",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "p-limit": "^7.3.2",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "ws": "^8.21.3",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "vitest": "^5.0.0"
  }
}
